        {
          "name": "SendMessage",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Lấy ngày hiện tại\r",
                  "let now = new Date();\r",
                  "\r",
                  "// Format yyyy-MM-dd\r",
                  "let formattedDate = now.toISOString().split('T')[0];\r",
                  "\r",
                  "// Lưu vào biến\r",
                  "pm.variables.set(\"currentDate\", formattedDate);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
